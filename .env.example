# ClickUp: a lista padrão continua sendo o fallback para destinos sem mapeamento.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_ALLOWED_ROLE_IDS=
# Opcional: se preenchido, limita a descoberta a este Workspace. Se vazio, usa o primeiro Workspace autorizado pelo token.
CLICKUP_WORKSPACE_ID=
CLICKUP_MANUAL_TRIAGE_QUERY=Backlog > Triage Manual
# O catálogo de listas é atualizado a cada 10 minutos.
CLICKUP_CATALOG_CACHE_SECONDS=600
# Legado opcional: usado apenas se a descoberta da hierarquia falhar.
CLICKUP_DESTINATIONS={}
# JSON: nomes internos dos campos -> IDs dos Custom Fields do ClickUp.
CLICKUP_CUSTOM_FIELD_IDS={}
CLICKUP_FREE_MODE=true
# As opções de dropdown são buscadas automaticamente da lista pela API do ClickUp.

