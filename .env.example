DISCORD_TOKEN=coloque_seu_token_aqui
COMMAND_PREFIX=a!
CHARACTER_FILE=bot/characters/default.json
MEMORY_LIMIT=12
GIF_PROVIDER_ORDER=klipy,apileague
KLIPY_API_KEY=
KLIPY_GIF_SEARCH_URL=https://api.klipy.com/api/v1/gifs/search
APILEAGUE_API_KEY=
GIPHY_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
IMAGE_PROVIDER_ORDER=ddgs,google
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TASK_AI_MODEL=gpt-5.4-mini
TASK_AI_TIMEOUT_SECONDS=120

# ClickUp: a lista padrão continua sendo o fallback para destinos sem mapeamento.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_ALLOWED_ROLE_IDS=
# Opcional: se preenchido, limita a descoberta a este Workspace. Se vazio, usa o primeiro Workspace autorizado pelo token.
CLICKUP_WORKSPACE_ID=
# O catálogo de listas é atualizado a cada 10 minutos.
CLICKUP_CATALOG_CACHE_SECONDS=600
# Legado opcional: usado apenas se a descoberta da hierarquia falhar.
CLICKUP_DESTINATIONS={}
# JSON: nomes internos dos campos -> IDs dos Custom Fields do ClickUp.
CLICKUP_CUSTOM_FIELD_IDS={}
CLICKUP_FREE_MODE=true
# As opções de dropdown são buscadas automaticamente da lista pela API do ClickUp.

LEVELS_DATABASE_PATH=data/levels.sqlite3
LEVELS_XP_MIN=15
LEVELS_XP_MAX=25
LEVELS_COOLDOWN_SECONDS=60
CHAT_CONFIG_PATH=data/chat_config.json
SITE_API_ENABLED=true
SITE_API_HOST=0.0.0.0
SITE_API_PORT=8090
SITE_API_CORS_ORIGIN=*
SITE_API_KEY=
DAILY_SITE_URL=https://msnafterlife.online/daily
YOUTUBE_COOKIES_PATH=
YOUTUBE_JS_RUNTIME_PATH=node
